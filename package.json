{
  "name": "browserstrike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test tests/browser.spec.ts --workers=1",
    "models:import": "node scripts/import-models.mjs",
    "models:collision": "tsx scripts/build-map-collision.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "lucide": "^0.468.0",
    "pathfinding": "^0.4.18",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.16",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pathfinding": "^0.1.0",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.0",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.3.0",
    "node-unrar-js": "^2.0.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
